{
  "name": "pullboard",
  "version": "0.9.2",
  "description": "Pullboard, local-first: a work board, lanes, a spec and git hooks that live in your repo. Nothing ships until a second agent verifies it.",
  "license": "MIT",
  "author": "Corey Olson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pullboard-dev/pullboard.git"
  },
  "bugs": {
    "url": "https://github.com/pullboard-dev/pullboard/issues"
  },
  "type": "module",
  "bin": {
    "pullboard": "bin/pullboard.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "pullboard",
    "ai-agents",
    "coding-agents",
    "multi-agent",
    "verification",
    "git-hooks",
    "local-first",
    "spec"
  ],
  "homepage": "https://pullboard.dev",
  "scripts": {
    "test": "node bin/run-tests.js",
    "gate": "node test/wall-clock-budgets.js && node bin/pullboard.js spec check && npm test",
    "hosted-shapes": "PULLBOARD_HOSTED_SHAPES=1 node bin/run-tests.js test/hosted-shapes.test.js"
  }
}
