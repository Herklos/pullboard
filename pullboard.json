{
  "name": "pullboard",
  "gate": "npm run gate",
  "affectedTests": "node bin/run-tests.js",
  "submitGate": "landing",
  "submitInvariants": [
    "test/refusal-next-steps.test.js"
  ],
  "spec": "SPEC.md",
  "verify": "any",
  "lease": "2h",
  "lanes": {
    "core": {
      "owns": [
        "src/",
        "bin/",
        "test/",
        "package.json",
        ".github/workflows/gate.yml",
        ".github/workflows/release.yml",
        "relay/",
        "docs/api.md",
        "docs/api.test.js",
        "docs/lifecycle.md",
        "docs/formats.md",
        "docs/formats.test.js"
      ],
      "specs": [
        "B",
        "V",
        "L",
        "S",
        "C",
        "R",
        "I",
        "A",
        "H",
        "E"
      ],
      "starts": "now"
    },
    "tests": {
      "owns": [],
      "specs": [
        "P"
      ],
      "starts": "any time: verifiers check submitted work and own no folders"
    },
    "docs": {
      "owns": [
        "docs/",
        "README.md",
        "test/readme.test.js",
        "skills/",
        "DOCTRINE.md",
        "PRACTICE.md",
        "CODE_OF_CONDUCT.md",
        "CHANGELOG.md",
        ".github/ISSUE_TEMPLATE/",
        ".github/pull_request_template.md",
        "CONTRIBUTING.md"
      ],
      "specs": [
        "I"
      ],
      "starts": "now"
    },
    "view": {
      "owns": [
        "src/cockpit.js",
        "src/serve.js",
        "src/view.css",
        "src/view/",
        "test/cockpit.test.js",
        "test/cockpit/",
        "test/journeys.test.js"
      ],
      "specs": [
        "N26",
        "N27",
        "N28"
      ],
      "starts": "now"
    }
  },
  "shared": [],
  "commits": {
    "requireIds": [
      "feat",
      "fix"
    ],
    "noEmoji": true
  },
  "staticChecks": "node --experimental-vm-modules --disable-warning=ExperimentalWarning bin/static-style-checks.js"
}
